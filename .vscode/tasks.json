{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "deploy to botkeep",
      "type": "shell",
      "command": "wsl.exe",
      "args": [
        "-d",
        "Ubuntu-24.04",
        "--",
        "bash",
        "-lc",
        "cd /mnt/c/Users/user/Documents/GitHub/pdf-converter-telegram-bot && bash deploy.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    }
  ]
}
